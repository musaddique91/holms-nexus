# MVX Nexus settings. Run ./scripts/setup.sh to create .env from this file with generated
# secrets, or copy it to .env and replace every "change-me" yourself (the backend refuses to
# start while a secret still says change-me).

# ---------------- Sign-in ----------------
HOLMES_ADMIN_USERNAME=admin
# Plain text, or a bcrypt hash written as {bcrypt}$2a$10$...
HOLMES_ADMIN_PASSWORD=change-me
# At least 32 random bytes, e.g. `openssl rand -base64 48`. Also encrypts API keys saved in the UI:
# changing it later makes saved keys unreadable (re-enter them under Models / Settings).
HOLMES_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# The address people open in the browser. Used for links in alerts and for CORS.
HOLMES_DASHBOARD_URL=http://localhost:8080
HOLMES_CORS_ORIGINS=http://localhost:8080

# ---------------- Ports ----------------
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose on the network (put TLS in front first:
# see deploy/nginx/example.conf).
NEXUS_BIND=127.0.0.1
NEXUS_PORT=8080
OPENOBSERVE_PORT=5080

# ---------------- Database (the bundled Postgres) ----------------
POSTGRES_PASSWORD=change-me

# ---------------- OpenObserve (log storage and search) ----------------
OPENOBSERVE_USER=admin@example.com
# Must contain upper case, lower case, a digit and a special character.
OPENOBSERVE_PASSWORD=change-me
OPENOBSERVE_ORG=default
OPENOBSERVE_RETENTION_DAYS=7

# ---------------- AI models ----------------
# Add providers in the UI: Settings → Models (keys are stored encrypted). Optionally seed
# providers on the very first start:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# e.g. http://host.docker.internal:11434 for Ollama on this machine
OLLAMA_BASE_URL=
# Cost guards for automatic investigations
HOLMES_MAX_PER_HOUR=30
HOLMES_CONCURRENCY=2

# ---------------- Ingestion ----------------
HOLMES_KAFKA_TOPIC=mvx.errors
# Shared secret for the webhooks under /api/ingest/* (header X-Holmes-Token)
HOLMES_WEBHOOK_TOKEN=change-me
# Optional: also pull ERROR rows from OpenObserve on a schedule
HOLMES_POLLER_ENABLED=false
# Shown as "host" on log lines collected on this machine
VECTOR_HOSTNAME=nexus-host

# ---------------- Git (read code, push fix branches, open pull requests) ----------------
# Global tokens; a service can also have its own token (Services → Edit).
# GitHub fine-grained token: Contents read/write + Pull requests read/write on your app repos.
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
HOLMES_DRAFT_PRS=true
HOLMES_FIX_MIN_CONFIDENCE=MEDIUM
HOLMES_GIT_AUTHOR_NAME=mvx-nexus
HOLMES_GIT_AUTHOR_EMAIL=mvx-nexus@example.com

# ---------------- Notifications ----------------
# Easiest in the UI: Intelligence → Settings → Notifications. These are first-start defaults.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#alerts

EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=MVX Nexus <alerts@example.com>
EMAIL_TO=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Investigation tools (all read-only) ----------------
HOLMES_DOCKER_ENABLED=true
HOLMES_COMPOSE_ENABLED=true
HOLMES_KUBERNETES_ENABLED=false
HOLMES_AWS_ENABLED=false
HOLMES_AZURE_ENABLED=false
GRAFANA_ENABLED=false
GRAFANA_URL=http://grafana:3000
# Grafana service-account token (Viewer role is enough)
GRAFANA_API_KEY=
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
PROMETHEUS_BEARER_TOKEN=
LOKI_ENABLED=false
LOKI_URL=http://loki:3100
LOKI_TENANT_ID=
OTEL_ENABLED=false
OTEL_URL=http://openobserve:5080
OTEL_TRACES_URL=
# Databases, Kafka clusters, MongoDB and RabbitMQ are listed in config/holmes.yml
# (copy config/holmes.example.yml).
