# SPA + API entry point. The host nginx (TLS) only forwards to this container.
#   /api/*  -> MVX Nexus backend (MVXHolmes + MCP), including MCP's streamed chat answers
#   else    -> the built SPA with history fallback
map $http_x_forwarded_proto $forwarded_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend per request through Docker DNS, so a redeploy that gives the
    # backend a new IP does not leave this container proxying to a dead address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $nexus_backend http://${HOLMES_BACKEND_UPSTREAM};

    client_max_body_size 5m;

    # blob:/data: for chart exports (PNG/SVG/PDF/CSV) and Highcharts images.
    set $csp "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy $csp always;

    location ^~ /api/ {
        proxy_pass $nexus_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        proxy_set_header Connection "";
        # MCP chat answers stream over SSE: pass each event through at once, here and in the
        # host nginx in front (X-Accel-Buffering), and allow the backend's 30-minute turns.
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no always;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $csp always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy $csp always;
        try_files $uri $uri/ /index.html;
    }
}
