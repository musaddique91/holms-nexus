# Secrets for the remote log agent (handed to Vector as Docker secrets, not env vars).
# The OpenObserve / mvx-holmes URLs are set directly in vector-remote.yaml.
OPENOBSERVE_USER=admin@example.com
OPENOBSERVE_PASSWORD=change-me
# Must equal HOLMES_WEBHOOK_TOKEN on the mvx-holmes backend
HOLMES_WEBHOOK_TOKEN=change-me
# Host name attached to every log line shipped from this VM
VECTOR_HOSTNAME=client-vm-1
